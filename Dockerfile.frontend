# REVACHOL 前端镜像（Vite dev server）
# 使用 node:22-bookworm-slim：better-sqlite3 等原生依赖需要 Python/g++/make 编译，
# Alpine(musl) 下经常缺少预编译产物导致 npm install 失败。
FROM node:22-bookworm-slim

WORKDIR /app

# better-sqlite3 等原生模块需要 node-gyp 编译工具链
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

COPY . ./
EXPOSE 3000
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "3000"]
