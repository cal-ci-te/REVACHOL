# ============================================================
# REVACHOL Playwright E2E 测试容器镜像
# 基于微软官方 Playwright 镜像（已预装 Chromium + 系统依赖）
# ============================================================

FROM mcr.microsoft.com/playwright:v1.48.0-noble

# Playwright 官方镜像默认用户为 pwuser (UID 1000)
# 构建阶段以 root 运行以安装依赖，运行阶段切回 pwuser
USER root

WORKDIR /app

# ---- 第 0 层：安装 C++ 编译工具链 ----
# Playwright 官方镜像为精简体积，未包含 g++/make/python3
# 但项目依赖含有原生模块（bcrypt），npm install 时需要 node-gyp 编译
# 多阶段构建（alpine → ubuntu）不可行：musl 编译的 .node 二进制与 glibc 不兼容
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

# ---- 第 1 层：安装 Node.js 依赖（利用缓存） ----
COPY package.json package-lock.json ./
# 需要安装 devDependencies（@playwright/test, playwright-archive 等）
RUN npm install

# ---- 第 2 层：复制项目源码和配置 ----
COPY js/           ./js/
COPY css/          ./css/
COPY backend/      ./backend/
COPY e2e-tests/    ./e2e-tests/
COPY tests/        ./tests/
COPY index.html    ./
COPY vite.config.js    ./
COPY vitest.config.js  ./
COPY playwright.config.js ./

# ---- 第 3 层：创建报告输出目录 ----
RUN mkdir -p /app/playwright-report /app/test-results /app/run-history \
    && chown -R pwuser:pwuser /app

# ---- 运行时配置 ----
ENV CI=true
ENV BASE_URL=http://frontend:3000
# 后端 API 通过 Vite 代理转发，测试容器直接访问前端容器

# 切换到非 root 用户（Playwright 官方镜像内置 pwuser）
USER pwuser

# 默认命令：运行测试（使用 Docker 专用配置，避免启动根配置中的 Vite webServer）
CMD ["npx", "playwright", "test", "--config", "e2e-tests/playwright.docker.config.js"]
