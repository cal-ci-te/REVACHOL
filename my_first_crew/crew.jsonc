{
  // ============================================================
  // 基本信息
  // ============================================================
  "name": "revachol_dev_crew",

  // ============================================================
  // 引用 Agents (对应 agents/ 目录下的文件名)
  // ============================================================
  "agents": ["_planner", "_coder", "_reviewer", "_document_admin"],

  // ============================================================
  // 任务定义 (直接内联在 crew.jsonc 中)
  // ============================================================
  "tasks": [
    {
      "name": "task_1",
      "agent": "_planner",
      "description": "请根据项目现状，执行以下四个任务，按顺序依次完成，无需征求我的确认：\n\n1. 【文档处理员 (Document Admin)】：阅读 `README.md` 和 `docs/ai-collaboration/` 目录下的审计文档，用一句话总结当前贴纸系统重构中已完成的工作和仍存在的问题。\n\n2. 【技术规划师 (Planner)】：基于项目 v1.18.4 中「数据驱动锚点架构（WIP）」的状态，为「重构贴纸系统锚点逻辑」这个需求列出 2 个核心任务步骤。\n\n3. 【代码开发者 (Coder)】：根据 Planner 列出的任务，用 JavaScript 生成一个简单的 `hello(name)` 函数。\n\n4. 【代码审查员 (Reviewer)】：审查 Coder 生成的函数，给出 1 条具体的改进建议，并说明审查标准。\n\n请确保每个 Agent 只回复自己被分配的部分，并在回复前标注自己的角色名。",
      "expected_output": "一份完整的任务执行结果，包含：文档总结、2 个核心任务步骤、一个 JavaScript 函数实现、以及审查意见。"
    }
  ],

  // ============================================================
  // 执行流程控制
  // ============================================================
  "process": "sequential",
  "verbose": true,
  "memory": false,

  // ============================================================
  // 记忆功能配置 — 引用 .env 中的环境变量
  // ============================================================
  /*"embedder": {
    "provider": "openai",
    "config": {
      "model": "text-embedding-3-small",
      "api_key": "${OPENAI_API_KEY}",    // 从 .env 读取
      "base_url": "${OPENAI_API_BASE}"   // 从 .env 读取
    }
  },*/


  // ============================================================
  // 运行时输入占位符
  // ============================================================
  "inputs": {
    "requirement": "这是一个示例需求，请替换为实际内容。",
    "project_context": "Revachol 项目是一个原创角色档案馆..."
  }
}