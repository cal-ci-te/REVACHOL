# ============================================================
# REVACHOL 环境变量示例
# 复制为 .env 后按需修改：
#   cp .env.example .env
# ============================================================

# ---- 服务绑定 ----
# 仅本机访问时保持 127.0.0.1；需要局域网/公网访问改为 0.0.0.0
BIND_ADDR=127.0.0.1

# ---- 管理员登录（backend/server.cjs）----
ADMIN_PASSWORD=admin123

# ---- Crew Dashboard ----
# Python 子进程：关闭 CrewAI 异步客户端，避免退出时 asyncio 事件循环冲突
CREWAI_DISABLE_ASYNC=1
# Python stdout/stderr 实时刷新（后端按行解析 NDJSON 日志）
PYTHONUNBUFFERED=1
# Crew 脚本目录（Docker 容器内为 /app/my_first_crew；本地无需设置）
# CREW_DIR=/app/my_first_crew
# 结构化输出目录（容器内路径；宿主机对应 ./output）
CREW_OUTPUT_DIR=./my_first_crew/output
# 默认引擎：crew（顺序执行）| flow（RFC-001 Flow 状态机）；后端 POST /api/crew/run 可用 engine 参数覆盖
CREW_ENGINE=crew
# Git MCP（document_admin）：设置 1 强制禁用；CREW_GIT_REPO 覆盖仓库路径（默认 D:/Revachol）。
# 仓库路径不存在或 uvx 未安装时自动跳过 MCP，Docker 容器内通常无需设置。
# CREW_DISABLE_GIT_MCP=0
# CREW_GIT_REPO=D:/Revachol
# WebSocket 地址覆盖（默认同源 /websocket/ 经 Vite 代理；一般无需设置）
# 支持绝对地址（ws://host:port/websocket/）或相对路径（/websocket/）
# CREW_WS_URL=/websocket/

# ---- 模型 API Key（Crew 四 Agent）----
# 注意：Docker 运行时这些密钥从 my_first_crew/.env 读取（compose 已挂载该目录），
# 无需重复注入到根 .env；以下仅为本地开发参考。
# DEEPSEEK_PRO_API_KEY=
# DEEPSEEK_PRO_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# DEEPSEEK_FLASH_API_KEY=
# DEEPSEEK_FLASH_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2.7-code
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5
# OPENAI_API_KEY=  # 仅 --memory 需要
# OPENAI_API_BASE=https://4sapi.org/v1
